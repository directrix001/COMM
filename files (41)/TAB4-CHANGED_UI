/**
 * tab4.js — Chat with Data
 * POST /api/tab4/ask  →  conversational Q&A
 * DELETE /api/tab4/clear  →  clear history
 */
(function () {
  'use strict';
  let initialised = false;

  function buildHTML() {
    return `
      <div class="va-section-label"><i class="bi bi-chat-dots"></i> Chat with Your Data</div>
      <p style="font-size:.82rem;color:var(--text-muted);margin-bottom:16px">
        Ask natural language questions about your loaded dataset (Tab 1 or Tab 2 data in session).
      </p>

      <!-- Chat window -->
      <div id="t4-chat-window" style="
        background:#fff; border:1px solid var(--border); border-radius:10px;
        height:420px; overflow-y:auto; padding:16px 20px; margin-bottom:12px;
        display:flex; flex-direction:column; gap:12px;
      ">
        <div class="t4-msg t4-assistant">
          <div class="t4-bubble">👋 Hi! Ask me anything about your loaded data — totals, top drivers, comparisons, etc.</div>
        </div>
      </div>

      <div id="t4-alert" class="va-alert mb-2"></div>

      <!-- Input row -->
      <div class="d-flex gap-2">
        <input class="form-control" id="t4-input" placeholder="Ask your dataset a question…" />
        <button class="btn-va-primary" id="t4-btn-send" style="white-space:nowrap">
          <i class="bi bi-send-fill"></i> Send
        </button>
        <button class="btn-va-outline" id="t4-btn-clear" style="white-space:nowrap">
          <i class="bi bi-trash3"></i> Clear
        </button>
      </div>
    `;
  }

  const CSS = `
    .t4-msg { display:flex; gap:8px; align-items:flex-start; }
    .t4-user      { flex-direction:row-reverse; }
    .t4-bubble {
      max-width:75%; padding:10px 14px; border-radius:12px;
      font-size:.82rem; line-height:1.55;
    }
    .t4-user .t4-bubble      { background:var(--blue); color:#fff; border-bottom-right-radius:3px; white-space:pre-wrap; }
    .t4-assistant .t4-bubble { background:#f1f5fb; color:var(--text); border-bottom-left-radius:3px; }
    .t4-typing { opacity:.5; font-style:italic; }

    /* ── Markdown content inside assistant bubble ── */
    .t4-md { font-size:.82rem; line-height:1.6; }
    .t4-md p  { margin:0 0 8px 0; }
    .t4-md p:last-child { margin-bottom:0; }
    .t4-md h1,.t4-md h2,.t4-md h3,.t4-md h4 {
      font-weight:600; margin:12px 0 4px 0; color:#1a2b45;
    }
    .t4-md h1 { font-size:1rem; }
    .t4-md h2 { font-size:.95rem; }
    .t4-md h3 { font-size:.88rem; }
    .t4-md ul,.t4-md ol { padding-left:18px; margin:4px 0 8px 0; }
    .t4-md li  { margin-bottom:3px; }
    .t4-md strong { font-weight:600; color:#1a2b45; }
    .t4-md em { font-style:italic; }
    .t4-md code {
      background:#e8edf4; border-radius:4px; padding:1px 5px;
      font-family:monospace; font-size:.78rem; color:#c7254e;
    }
    .t4-md pre {
      background:#1e2a38; color:#e8edf4; border-radius:8px;
      padding:12px 14px; overflow-x:auto; margin:8px 0;
    }
    .t4-md pre code { background:none; color:inherit; padding:0; font-size:.78rem; }
    .t4-md blockquote {
      border-left:3px solid var(--blue,#3b82f6); padding:6px 12px;
      background:#eef3fb; border-radius:0 6px 6px 0; margin:6px 0;
      color:#374151; font-style:italic;
    }
    .t4-md hr { border:none; border-top:1px solid #d1d9e6; margin:10px 0; }

    /* ── Markdown table ── */
    .t4-table-wrap {
      overflow-x:auto; margin:8px 0; border-radius:8px;
      box-shadow:0 1px 6px rgba(0,0,0,.08);
    }
    .t4-md table {
      border-collapse:collapse; width:100%; min-width:320px;
      font-size:.78rem; background:#fff;
    }
    .t4-md thead tr { background:#1e3a5f; color:#fff; }
    .t4-md thead th {
      padding:8px 12px; text-align:left; font-weight:600;
      border:none; white-space:nowrap;
    }
    .t4-md tbody tr:nth-child(even) { background:#f0f4fa; }
    .t4-md tbody tr:nth-child(odd)  { background:#fff; }
    .t4-md tbody tr:hover           { background:#dbeafe; }
    .t4-md tbody td {
      padding:7px 12px; border-bottom:1px solid #e2e8f0;
      color:#374151; vertical-align:top;
    }
    .t4-md tfoot td {
      padding:7px 12px; font-weight:600; background:#eef3fb;
      border-top:2px solid #cbd5e1; color:#1e3a5f;
    }
  `;

  /* ─────────────────────────────────────────────────────────────────
   * Lightweight Markdown → HTML renderer
   * Handles: headings, bold, italic, code, pre, blockquote,
   *           hr, ul/ol lists, pipe tables, paragraphs
   * ───────────────────────────────────────────────────────────────── */
  function renderMarkdown(raw) {
    if (!raw) return '';

    const lines  = raw.replace(/\r\n/g, '\n').split('\n');
    const output = [];
    let i = 0;

    // --- helpers ---
    function escHtmlInner(s) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function inlineFormat(s) {
      return escHtmlInner(s)
        // Bold+italic ***text***
        .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
        // Bold **text** or __text__
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/__(.+?)__/g,     '<strong>$1</strong>')
        // Italic *text* or _text_
        .replace(/\*([^*]+?)\*/g, '<em>$1</em>')
        .replace(/_([^_]+?)_/g,   '<em>$1</em>')
        // Inline code `code`
        .replace(/`([^`]+?)`/g, '<code>$1</code>');
    }

    // Is this line a table separator? (e.g. |---|---|)
    function isTableSep(line) {
      return /^\|?(\s*:?-+:?\s*\|)+\s*:?-+:?\s*\|?\s*$/.test(line.trim());
    }

    // Is this line a table row?
    function isTableRow(line) {
      return line.trim().startsWith('|') || (line.includes('|') && !isTableSep(line));
    }

    function parseTableRow(line) {
      // Split by | but ignore escaped pipes; trim cell content
      return line.trim()
        .replace(/^\|/, '').replace(/\|$/, '')
        .split('|')
        .map(c => c.trim());
    }

    function renderTable(tableLines) {
      if (tableLines.length < 2) return tableLines.map(l => `<p>${inlineFormat(l)}</p>`).join('');

      const headers = parseTableRow(tableLines[0]);
      // Find separator row
      let dataStart = 1;
      if (isTableSep(tableLines[1])) dataStart = 2;

      const bodyRows = tableLines.slice(dataStart);

      let html = '<div class="t4-table-wrap"><table>';
      html += '<thead><tr>' + headers.map(h => `<th>${inlineFormat(h)}</th>`).join('') + '</tr></thead>';
      html += '<tbody>';
      for (const row of bodyRows) {
        if (!row.trim()) continue;
        const cells = parseTableRow(row);
        html += '<tr>' + cells.map(c => `<td>${inlineFormat(c)}</td>`).join('') + '</tr>';
      }
      html += '</tbody></table></div>';
      return html;
    }

    // --- collect fenced code block ---
    function collectCodeBlock() {
      const fence = lines[i]; // ``` or ```lang
      const lang  = fence.replace(/^```+/, '').trim();
      i++;
      const codeLines = [];
      while (i < lines.length && !lines[i].startsWith('```')) {
        codeLines.push(escHtmlInner(lines[i]));
        i++;
      }
      i++; // skip closing ```
      return `<pre><code${lang ? ` class="language-${lang}"` : ''}>${codeLines.join('\n')}</code></pre>`;
    }

    // --- collect list ---
    function collectList(ordered) {
      const tag   = ordered ? 'ol' : 'ul';
      const regex = ordered ? /^\d+\.\s+/ : /^[-*+]\s+/;
      let html    = `<${tag}>`;
      while (i < lines.length && regex.test(lines[i])) {
        html += `<li>${inlineFormat(lines[i].replace(regex, '').trim())}</li>`;
        i++;
      }
      html += `</${tag}>`;
      return html;
    }

    // --- collect table ---
    function collectTable() {
      const tableLines = [];
      while (i < lines.length && (isTableRow(lines[i]) || isTableSep(lines[i]))) {
        tableLines.push(lines[i]);
        i++;
      }
      return renderTable(tableLines);
    }

    // --- collect blockquote ---
    function collectBlockquote() {
      const bqLines = [];
      while (i < lines.length && lines[i].startsWith('>')) {
        bqLines.push(lines[i].replace(/^>\s?/, ''));
        i++;
      }
      return `<blockquote>${inlineFormat(bqLines.join(' '))}</blockquote>`;
    }

    // --- collect paragraph ---
    function collectParagraph() {
      const pLines = [];
      while (
        i < lines.length &&
        lines[i].trim() !== '' &&
        !lines[i].startsWith('#') &&
        !lines[i].startsWith('```') &&
        !lines[i].startsWith('>') &&
        !/^[-*+]\s/.test(lines[i]) &&
        !/^\d+\.\s/.test(lines[i]) &&
        !isTableRow(lines[i]) &&
        !isTableSep(lines[i]) &&
        !/^---+$/.test(lines[i].trim())
      ) {
        pLines.push(inlineFormat(lines[i]));
        i++;
      }
      if (!pLines.length) return '';
      return `<p>${pLines.join('<br>')}</p>`;
    }

    // --- main parse loop ---
    while (i < lines.length) {
      const line = lines[i];

      // blank line
      if (line.trim() === '') { i++; continue; }

      // fenced code block
      if (line.startsWith('```')) { output.push(collectCodeBlock()); continue; }

      // headings
      const hm = line.match(/^(#{1,4})\s+(.*)/);
      if (hm) {
        const level = hm[1].length;
        output.push(`<h${level}>${inlineFormat(hm[2])}</h${level}>`);
        i++; continue;
      }

      // horizontal rule
      if (/^---+$/.test(line.trim()) || /^\*\*\*+$/.test(line.trim())) {
        output.push('<hr>'); i++; continue;
      }

      // blockquote
      if (line.startsWith('>')) { output.push(collectBlockquote()); continue; }

      // unordered list
      if (/^[-*+]\s/.test(line)) { output.push(collectList(false)); continue; }

      // ordered list
      if (/^\d+\.\s/.test(line)) { output.push(collectList(true)); continue; }

      // table (pipe-delimited)
      if (isTableRow(line) || isTableSep(line)) { output.push(collectTable()); continue; }

      // paragraph
      const p = collectParagraph();
      if (p) output.push(p);
    }

    return output.join('\n');
  }

  /* ── Init ─────────────────────────────────────────────────────── */

  function init() {
    if (initialised) return;
    initialised = true;
    if (!document.getElementById('t4-style')) {
      const s = document.createElement('style'); s.id = 't4-style'; s.textContent = CSS;
      document.head.appendChild(s);
    }
    document.getElementById('tab4-content').innerHTML = buildHTML();
    bindEvents();
  }

  function bindEvents() {
    document.getElementById('t4-btn-send').addEventListener('click', handleSend);
    document.getElementById('t4-input').addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); }
    });
    document.getElementById('t4-btn-clear').addEventListener('click', handleClear);
  }

  /* ── Send / Clear ─────────────────────────────────────────────── */

  async function handleSend() {
    const input = document.getElementById('t4-input');
    const q = input.value.trim();
    if (!q) return;

    vaAlertClear('t4-alert');
    appendMsg('user', q);
    input.value = '';

    const typingId = appendTyping();
    setLoading(true);

    try {
      const data = await vaPost('/api/tab4/ask', { question: q });
      removeMsg(typingId);
      appendAssistant(data.answer || '(No answer returned)');
    } catch (e) {
      removeMsg(typingId);
      appendAssistant(`❌ **Error:** ${e.message}`);
    } finally {
      setLoading(false);
    }
  }

  async function handleClear() {
    try { await fetch('/api/tab4/clear', { method: 'DELETE' }); } catch (_) {}
    const win = document.getElementById('t4-chat-window');
    win.innerHTML = `<div class="t4-msg t4-assistant">
      <div class="t4-bubble t4-md"><p>Chat cleared. Ask me anything about your data!</p></div>
    </div>`;
  }

  /* ── Message helpers ──────────────────────────────────────────── */

  let _msgId = 0;

  // User bubble — plain escaped text, pre-wrap
  function appendMsg(role, text) {
    const id  = `t4-msg-${_msgId++}`;
    const win = document.getElementById('t4-chat-window');
    const div = document.createElement('div');
    div.id        = id;
    div.className = `t4-msg t4-${role}`;
    div.innerHTML = `<div class="t4-bubble">${escHtml(text)}</div>`;
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return id;
  }

  // Typing indicator
  function appendTyping() {
    const id  = `t4-msg-${_msgId++}`;
    const win = document.getElementById('t4-chat-window');
    const div = document.createElement('div');
    div.id        = id;
    div.className = 't4-msg t4-assistant';
    div.innerHTML = `<div class="t4-bubble t4-typing">⏳ Thinking…</div>`;
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return id;
  }

  // Assistant bubble — rendered Markdown
  function appendAssistant(mdText) {
    const id  = `t4-msg-${_msgId++}`;
    const win = document.getElementById('t4-chat-window');
    const div = document.createElement('div');
    div.id        = id;
    div.className = 't4-msg t4-assistant';
    const inner   = document.createElement('div');
    inner.className = 't4-bubble t4-md';
    inner.innerHTML = renderMarkdown(mdText);
    div.appendChild(inner);
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return id;
  }

  function removeMsg(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
  }

  function setLoading(on) {
    document.getElementById('t4-btn-send').disabled = on;
    document.getElementById('t4-input').disabled    = on;
  }

  function escHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  window.addEventListener('va:tabchange', e => { if (e.detail === 'tab4') init(); });
})();
