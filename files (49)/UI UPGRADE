  // ══════════════════════════════════════════════════════════════════════
  //  RICH RESPONSE RENDERER
  //  Converts AI plain-text / markdown into structured HTML.
  // ══════════════════════════════════════════════════════════════════════
  function renderRichResponse(raw) {
    // Safety: if looks like an error/short message, just escape it
    if (!raw || raw.length < 6) return `<span>${esc(raw)}</span>`;

    let html = '';
    const lines = raw.split('\n');
    let i = 0;

    // ── helpers ──────────────────────────────────────────────────────
    function peek() { return lines[i] || ''; }
    function consume() { return lines[i++]; }

    // Inline markdown → HTML (bold, italic, inline-code, links)
    function inlineFormat(txt) {
      return txt
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        // bold+italic
        .replace(/\*\*\*(.+?)\*\*\*/g,'<strong><em>$1</em></strong>')
        // bold
        .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
        .replace(/__(.+?)__/g,'<strong>$1</strong>')
        // italic
        .replace(/\*(.+?)\*/g,'<em>$1</em>')
        .replace(/_(.+?)_/g,'<em>$1</em>')
        // inline code
        .replace(/`([^`]+)`/g,'<code>$1</code>')
        // bare URLs
        .replace(/(https?:\/\/[^\s<]+)/g,'<a href="$1" target="_blank" rel="noopener" style="color:var(--blue);word-break:break-all">$1</a>');
    }

    // Detect if a line starts a markdown table (| col | col |)
    function isTableRow(line) { return /^\s*\|.+\|/.test(line); }
    function isSeparator(line){ return /^\s*\|[\s\-|:]+\|/.test(line); }

    // ── TABLE PARSER ──────────────────────────────────────────────────
    function parseTable() {
      const rows = [];
      while (i < lines.length && isTableRow(peek())) {
        const line = consume();
        if (isSeparator(line)) continue; // skip --- separator row
        const cells = line.split('|').map(c => c.trim()).filter((c,idx,arr)=>idx>0&&idx<arr.length-1);
        rows.push(cells);
      }
      if (rows.length === 0) return '';

      const headers = rows[0];
      const body    = rows.slice(1);

      // Detect numeric columns (>50% of body cells look like numbers)
      function isNumCol(ci) {
        if (body.length === 0) return false;
        const numericCount = body.filter(r => /^-?[\d,€$£¥%\s().]+$/.test((r[ci]||'').trim())).length;
        return numericCount / body.length > 0.5;
      }
      // Detect variance columns (header contains "var","diff","delta","change","±")
      function isVarCol(ci) {
        return /var|diff|delta|change|±|adv|fav/i.test(headers[ci] || '');
      }

      let out = '<div class="t4-table-wrap"><table><thead><tr>';
      headers.forEach(h => { out += `<th>${inlineFormat(h)}</th>`; });
      out += '</tr></thead><tbody>';

      body.forEach(row => {
        out += '<tr>';
        headers.forEach((_, ci) => {
          const cell = row[ci] !== undefined ? row[ci] : '';
          let cls = '';
          if (isNumCol(ci)) cls += ' t4-num';
          if (isVarCol(ci)) {
            const num = parseFloat(cell.replace(/[^0-9.\-]/g,''));
            if (!isNaN(num)) cls += num < 0 ? ' t4-neg' : ' t4-pos';
          }
          out += `<td class="${cls.trim()}">${inlineFormat(cell)}</td>`;
        });
        out += '</tr>';
      });

      out += '</tbody></table></div>';
      return out;
    }

    // ── DETECT KPI PATTERN ────────────────────────────────────────────
    // Lines like:  **Total Variance**: €1.2M  or  - **Label**: value
    // If 2-5 consecutive such lines exist → render as KPI cards
    function isKpiLine(line) {
      return /^\*\*[^*]+\*\*\s*[:–-]\s*.+/.test(line.trim()) ||
             /^-\s*\*\*[^*]+\*\*\s*[:–-]\s*.+/.test(line.trim());
    }

    function parseKpiBlock(firstLine) {
      const items = [firstLine];
      while (i < lines.length && isKpiLine(peek()) && items.length < 5) {
        items.push(consume());
      }
      if (items.length < 2) {
        // Not enough for a KPI row — just treat as normal line
        return `<p>${inlineFormat(firstLine.trim())}</p>`;
      }
      let out = '<div class="t4-kpi-row">';
      items.forEach(line => {
        const m = line.replace(/^-\s*/,'').match(/^\*\*(.+?)\*\*\s*[:–-]\s*(.+)/);
        if (m) {
          out += `<div class="t4-kpi-card">
            <div class="t4-kpi-val">${inlineFormat(m[2].trim())}</div>
            <div class="t4-kpi-lbl">${inlineFormat(m[1].trim())}</div>
          </div>`;
        } else {
          out += `<div class="t4-kpi-card"><div class="t4-kpi-val">${inlineFormat(line.trim())}</div></div>`;
        }
      });
      out += '</div>';
      return out;
    }

    // ── CALLOUT DETECTOR ──────────────────────────────────────────────
    // Lines starting with ⚠️ ❌ ✅ ℹ️ 💡 → styled callout boxes
    function getCalloutType(line) {
      if (/^[⚠️🟡]/.test(line)) return { cls:'t4-callout-warn',   icon:'bi-exclamation-triangle-fill' };
      if (/^[❌🔴]/.test(line))  return { cls:'t4-callout-danger', icon:'bi-x-circle-fill' };
      if (/^[✅🟢]/.test(line))  return { cls:'t4-callout-success',icon:'bi-check-circle-fill' };
      if (/^[ℹ️💡🔵]/.test(line))return { cls:'t4-callout-info',   icon:'bi-info-circle-fill' };
      return null;
    }

    // ── NUMBERED ACTION LIST ──────────────────────────────────────────
    // Consecutive lines like  "1. Do this"  "2. Do that" → styled steps
    function isOrderedItem(line) { return /^\d+\.\s+/.test(line.trim()); }

    function parseOrderedList() {
      let out = '<ol class="t4-steps">';
      while (i < lines.length && isOrderedItem(peek())) {
        const line = consume().trim().replace(/^\d+\.\s+/,'');
        out += `<li><span class="t4-step-num">${getStepNum(out)}</span><span>${inlineFormat(line)}</span></li>`;
      }
      out += '</ol>';
      return out;
    }

    function getStepNum(html) {
      return (html.match(/<li>/g)||[]).length + 1;
    }

    // ── UNORDERED LIST ────────────────────────────────────────────────
    function isUnorderedItem(line) { return /^[-*•]\s+/.test(line.trim()); }

    function parseUnorderedList() {
      let out = '<ul>';
      while (i < lines.length && isUnorderedItem(peek())) {
        const line = consume().trim().replace(/^[-*•]\s+/,'');
        out += `<li>${inlineFormat(line)}</li>`;
      }
      out += '</ul>';
      return out;
    }

    // ── MAIN PARSE LOOP ───────────────────────────────────────────────
    while (i < lines.length) {
      const line = consume();
      const trimmed = line.trim();

      // blank
      if (!trimmed) { html += ''; continue; }

      // headings
      if (/^#{1}\s+/.test(trimmed)) { html += `<h1>${inlineFormat(trimmed.replace(/^#+\s+/,''))}</h1>`; continue; }
      if (/^#{2}\s+/.test(trimmed)) { html += `<h2>${inlineFormat(trimmed.replace(/^#+\s+/,''))}</h2>`; continue; }
      if (/^#{3,}\s+/.test(trimmed)){ html += `<h3>${inlineFormat(trimmed.replace(/^#+\s+/,''))}</h3>`; continue; }

      // horizontal rule
      if (/^[-*_]{3,}$/.test(trimmed)) { html += '<hr>'; continue; }

      // blockquote
      if (/^>\s*/.test(trimmed)) { html += `<blockquote>${inlineFormat(trimmed.replace(/^>\s*/,''))}</blockquote>`; continue; }

      // markdown table
      if (isTableRow(trimmed)) {
        i--; // back up so parseTable reads this line
        html += parseTable();
        continue;
      }

      // callout (emoji-prefixed lines)
      const callout = getCalloutType(trimmed);
      if (callout) {
        html += `<div class="t4-callout ${callout.cls}"><i class="bi ${callout.icon}"></i><span>${inlineFormat(trimmed)}</span></div>`;
        continue;
      }

      // ordered list
      if (isOrderedItem(trimmed)) {
        i--; // back up
        html += parseOrderedList();
        continue;
      }

      // unordered list
      if (isUnorderedItem(trimmed)) {
        i--; // back up
        html += parseUnorderedList();
        continue;
      }

      // KPI pattern (bold key: value)
      if (isKpiLine(trimmed)) {
        i--; // back up
        html += parseKpiBlock(consume());
        continue;
      }

      // default paragraph
      html += `<p>${inlineFormat(trimmed)}</p>`;
    }

    return `<div class="t4-rich">${html}</div>`;
  }

  // ── RENDER PERSONA BANNER ─────────────────────────────────────────────
  function renderPersonaBanner() {
    const persona = getCurrentPersona();
    const banner  = document.getElementById('t4-persona-banner');
    if (!banner) return;

    banner.style.borderColor = persona.color;
    banner.style.background  = persona.color + '10';

    document.getElementById('t4-banner-icon').style.color = persona.color;
    document.getElementById('t4-banner-name').textContent = persona.label;
    document.getElementById('t4-banner-name').style.color = persona.color;

    const hints = {
      CFO:              "— prompts tuned to strategic, high-level P&L questions",
      VP_FINANCE:       "— prompts tuned to budget stewardship and cost control",
      BUSINESS_PARTNER: "— prompts tuned to operational root-cause and team actions",
      BOARD:            "— prompts tuned to board-level narrative and governance",
      AUDITOR:          "— prompts tuned to materiality, controls and JSOX compliance",
      FP_A:             "— prompts tuned to detailed driver analysis and modelling",
    };
    const pid = window.__va_persona || 'CFO';
    document.getElementById('t4-banner-hint').textContent = hints[pid] || "";
  }

  // ── RENDER PROMPT GROUPS ──────────────────────────────────────────────
  function renderPromptGroups() {
    const persona = getCurrentPersona();
    const groups  = persona.groups;
    activeGroup   = 0;

    const tabsEl = document.getElementById('t4-group-tabs');
    if (!tabsEl) return;
    tabsEl.innerHTML = groups.map((g, i) => `
      <button class="t4-group-tab ${i===0?'active':''}" data-gi="${i}"
        style="${i===0 ? `border-color:${g.color};color:${g.color};background:${g.color}18` : ''}">
        <i class="bi ${g.icon}"></i> ${g.label}
      </button>`).join('');

    renderChips(groups[0]);

    tabsEl.addEventListener('click', e => {
      const btn = e.target.closest('.t4-group-tab');
      if (!btn) return;
      activeGroup = parseInt(btn.dataset.gi, 10);
      const g = groups[activeGroup];
      tabsEl.querySelectorAll('.t4-group-tab').forEach((b, i) => {
        const isMe = i === activeGroup;
        b.classList.toggle('active', isMe);
        b.style.borderColor = isMe ? g.color : '';
        b.style.color       = isMe ? g.color : '';
        b.style.background  = isMe ? g.color + '18' : '';
      });
      renderChips(g);
    });
  }

  function renderChips(group) {
    const el = document.getElementById('t4-prompt-chips');
    if (!el) return;
    el.innerHTML = group.prompts.map(p =>
      `<button class="t4-prompt-chip" data-prompt="${p.replace(/"/g,'&quot;')}">${p}</button>`
    ).join('');
    el.querySelectorAll('.t4-prompt-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.getElementById('t4-input').value = chip.dataset.prompt;
        document.getElementById('t4-input').focus();
        handleSend();
      });
    });
  }

  // ── INIT ────────────────────────────────────────────────────────────────
  function init() {
    if (initialised) return;
    initialised = true;
    document.getElementById('tab4-content').innerHTML = buildHTML();
    bindEvents();
    renderPersonaBanner();
    renderPromptGroups();
    checkDataStatus();
  }

  function refresh() {
    if (!initialised) { init(); return; }
    renderPersonaBanner();
    renderPromptGroups();
    checkDataStatus();
  }

  async function checkDataStatus() {
    try {
      await vaGet('/api/tab2/filters');
      const el = document.getElementById('t4-source-status');
      if (el) { el.className = 't4-source-status ok'; el.innerHTML = '<i class="bi bi-check-circle-fill"></i><span>Data loaded from session — ready to chat!</span>'; }
    } catch (_) {}
  }

  function bindEvents() {
    document.getElementById('t4-input').addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); }
    });
    document.getElementById('t4-btn-send').addEventListener('click', handleSend);
    document.getElementById('t4-btn-clear').addEventListener('click', handleClear);
    document.getElementById('t4-banner-change').addEventListener('click', e => {
      e.preventDefault();
      const tab3btn = document.querySelector('.va-tab[data-tab="tab3"]');
      if (tab3btn) tab3btn.click();
    });
  }

  // ── SEND ─────────────────────────────────────────────────────────────
  async function handleSend() {
    const input = document.getElementById('t4-input');
    const q = input.value.trim();
    if (!q) return;

    vaAlertClear('t4-alert');
    appendMsg('user', q);
    input.value = '';

    const typingId = appendTyping();
    setLoading(true);

    try {
      const data = await vaPost('/api/tab4/ask', { question: q });
      removeMsg(typingId);
      // ── Use rich renderer for assistant replies ──
      appendRichMsg(data.answer || '(No answer returned)');
    } catch (e) {
      removeMsg(typingId);
      appendRichMsg(
        e.message.includes('404')
          ? '⚠️ No data in session. Run Tab 1 Mapping or Tab 2 Variance Analysis first, then return here.'
          : `❌ Error: ${e.message}`
      );
    } finally {
      setLoading(false);
    }
  }

  // ── CLEAR ────────────────────────────────────────────────────────────
  async function handleClear() {
    try { await fetch('/api/tab4/clear', { method: 'DELETE' }); } catch(_) {}
    const win = document.getElementById('t4-chat-window');
    win.innerHTML = `
      <div class="t4-msg t4-assistant">
        <div class="t4-avatar"><i class="bi bi-robot"></i></div>
        <div class="t4-bubble">Chat cleared. Ask me anything about your loaded data!</div>
      </div>`;
  }

  // ── MESSAGE HELPERS ──────────────────────────────────────────────────
  let _mid = 0;

  function appendMsg(role, text) {
    const id  = `t4m${_mid++}`;
    const win = document.getElementById('t4-chat-window');
    const icon = role === 'user' ? 'bi-person-fill' : 'bi-robot';
    const div = document.createElement('div');
    div.id = id; div.className = `t4-msg t4-${role}`;
    div.innerHTML = `<div class="t4-avatar"><i class="bi ${icon}"></i></div>
      <div class="t4-bubble">${esc(text)}</div>`;
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return id;
  }

  // ── NEW: Rich assistant message (uses renderer) ───────────────────────
  function appendRichMsg(rawText) {
    const id  = `t4m${_mid++}`;
    const win = document.getElementById('t4-chat-window');
    const div = document.createElement('div');
    div.id = id; div.className = 't4-msg t4-assistant';
    div.innerHTML = `
      <div class="t4-avatar"><i class="bi bi-robot"></i></div>
      <div class="t4-bubble" style="max-width:85%;padding:13px 16px">
        ${renderRichResponse(rawText)}
      </div>`;
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return id;
  }

  function appendTyping() {
    const id  = `t4m${_mid++}`;
    const win = document.getElementById('t4-chat-window');
    const div = document.createElement('div');
    div.id = id; div.className = 't4-msg t4-assistant t4-typing';
    div.innerHTML = `<div class="t4-avatar"><i class="bi bi-robot"></i></div>
      <div class="t4-bubble"><span class="t4-dot"></span><span class="t4-dot"></span><span class="t4-dot"></span></div>`;
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return id;
  }

  function removeMsg(id) { const el = document.getElementById(id); if (el) el.remove(); }

  function setLoading(on) {
    document.getElementById('t4-btn-send').disabled = on;
    document.getElementById('t4-input').disabled    = on;
  }

  function esc(s) {
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/\n/g,'<br>');
  }

  window.addEventListener('va:tabchange', e => {
    if (e.detail === 'tab4') refresh();
  });

})();
